{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "composite": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "useDefineForClassFields": true,
    "jsx": "preserve"
  },
  "include": [
    "src/renderer/src/**/*",
    "src/main/database.ts",
    "src/main/sqljs.d.ts"
  ]
}
