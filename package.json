{
  "name": "arqstudio3d",
  "version": "0.1.0",
  "description": "Editor visual de arquitectura/diseño 3D asistido por IA — Open Form Studio",
  "author": "Open Form Studio Team <info@openformstudio.com>",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "test": "node scripts/_run-costs-tests.mjs && node scripts/_run-bim-tests.mjs && node scripts/_run-openings-tests.mjs",
    "test:bim": "node scripts/_run-bim-tests.mjs",
    "test:openings": "node scripts/_run-openings-tests.mjs",
    "test:costs": "node scripts/_run-costs-tests.mjs",
    "capture:costs": "node scripts/_run-capture-costs.mjs",
    "start": "electron-vite preview --noSandbox",
    "test:projects": "node scripts/_run-projects-tests.mjs",
    "test:export": "vitest run src/renderer/src/export/ src/renderer/src/import/",
    "verify:export": "node scripts/_verify-export.mjs",
    "capture:fase1": "npm run build && xvfb-run -a node_modules/.bin/electron --no-sandbox scripts/capture-fase1.mjs",
    "package": "npm run build && electron-builder --linux AppImage",
    "dist": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.openformstudio.app",
    "productName": "Open Form Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Graphics",
      "icon": "build/icon.png"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "protocols": [
      {
        "name": "ArqStudio",
        "schemes": [
          "arqstudio"
        ]
      }
    ]
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "pdfjs-dist": "^4.10.38",
    "sql.js": "^1.14.2",
    "three": "^0.166.1"
  },
  "devDependencies": {
    "@types/three": "^0.166.0",
    "electron": "^31.0.2",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "typescript": "^5.5.3",
    "vite": "^5.3.3",
    "vitest": "^2.1.9"
  }
}
