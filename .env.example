# ---- Gemini (Fase 3) ---------------------------------------------------------
# La clave se lee SOLO en el proceso principal de Electron y nunca viaja al
# renderer. Consíguela en https://aistudio.google.com/apikey
#   · Formato válido: empieza por "AIza" (~39 caracteres).
#   · Si la dejas vacía, la app funciona con el cerebro local (sin Gemini).
GEMINI_API_KEY=TU_API_KEY_AQUI
GEMINI_MODEL=gemini-3.8-flash

